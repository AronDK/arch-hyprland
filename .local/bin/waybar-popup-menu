#!/usr/bin/env python3
"""Material 3 layer-shell popup used by Waybar controls."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell


ENTER_ANIMATION_MS = 400
EXIT_ANIMATION_MS = 200
CARD_WIDTH = 408
EDGE_MARGIN = 12


def cubic_bezier(x1: float, y1: float, x2: float, y2: float, value: float) -> float:
    """Evaluate a CSS cubic-bezier curve at an x-axis progress value."""
    low, high = 0.0, 1.0
    for _ in range(14):
        t = (low + high) / 2
        inverse = 1 - t
        x = 3 * inverse * inverse * t * x1 + 3 * inverse * t * t * x2 + t**3
        if x < value:
            low = t
        else:
            high = t
    t = (low + high) / 2
    inverse = 1 - t
    return 3 * inverse * inverse * t * y1 + 3 * inverse * t * t * y2 + t**3


class IconMorph(Gtk.Bin):
    """Scale a complete menu surface out of the icon that launched it."""

    def __init__(self, origin_x: float) -> None:
        super().__init__()
        self.origin_x = origin_x
        self.progress = 0.0
        self.start_progress = 0.0
        self.target_progress = 0.0
        self.started_at = 0.0
        self.duration_ms = ENTER_ANIMATION_MS
        self.tick_id = 0
        self.finished = None

    def animate(self, reveal: bool, finished=None) -> None:
        self.start_progress = self.progress
        self.target_progress = 1.0 if reveal else 0.0
        self.started_at = time.monotonic()
        self.duration_ms = ENTER_ANIMATION_MS if reveal else EXIT_ANIMATION_MS
        self.finished = finished
        if not self.tick_id:
            self.tick_id = self.add_tick_callback(self._tick)

    def _tick(self, _widget: Gtk.Widget, _clock: Gdk.FrameClock) -> bool:
        elapsed = (time.monotonic() - self.started_at) * 1000
        linear = min(1.0, elapsed / self.duration_ms)
        if self.target_progress > self.start_progress:
            eased = cubic_bezier(0.05, 0.7, 0.1, 1.0, linear)
        else:
            eased = cubic_bezier(0.3, 0.0, 0.8, 0.15, linear)
        self.progress = self.start_progress + (
            self.target_progress - self.start_progress
        ) * eased
        self.queue_draw()
        if linear < 1.0:
            return GLib.SOURCE_CONTINUE
        self.progress = self.target_progress
        self.tick_id = 0
        callback, self.finished = self.finished, None
        if callback is not None:
            callback()
        return GLib.SOURCE_REMOVE

    def do_draw(self, cr) -> bool:
        # Keep the final frame pixel-perfect. During motion, scale both axes
        # around the icon's horizontal center and the card's nearest edge.
        if self.progress >= 0.999:
            return Gtk.Bin.do_draw(self, cr)
        scale_x = 0.07 + 0.93 * self.progress
        scale_y = 0.025 + 0.975 * self.progress
        cr.save()
        cr.translate(self.origin_x, 0)
        cr.scale(scale_x, scale_y)
        cr.translate(-self.origin_x, 0)
        result = Gtk.Bin.do_draw(self, cr)
        cr.restore()
        return result


def waybar_bottom(monitor_name: str, monitor_y: int) -> int:
    """Return Waybar's bottom edge in monitor-local logical coordinates."""
    try:
        layers = json.loads(
            subprocess.check_output(
                ["hyprctl", "-j", "layers"], text=True, stderr=subprocess.DEVNULL
            )
        )
        for level in layers.get(monitor_name, {}).get("levels", {}).values():
            for layer in level:
                if layer.get("namespace") == "waybar":
                    return max(0, int(layer["y"]) + int(layer["h"]) - monitor_y)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        pass
    return 41


def waybar_output() -> str:
    runtime = GLib.get_user_runtime_dir()
    try:
        return Path(f"{runtime}/waybar-main-output").read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def make_label(text: str, css_class: str, xalign: float = 0) -> Gtk.Label:
    widget = Gtk.Label(label=text)
    widget.set_xalign(xalign)
    widget.set_ellipsize(3)
    widget.get_style_context().add_class(css_class)
    return widget


class Popup:
    def __init__(self, model: dict, password: bool, pointer_x: int, pointer_y: int) -> None:
        self.model = model
        self.password = password
        self.result_written = False
        self.closing = False
        self.ready = False
        self.controls: list[Gtk.Widget] = []

        display = Gdk.Display.get_default()
        monitor = display.get_monitor_at_point(pointer_x, pointer_y)
        geometry = monitor.get_geometry()
        card_width = min(CARD_WIDTH, geometry.width - 2 * EDGE_MARGIN)
        local_pointer_x = pointer_x - geometry.x
        card_x = local_pointer_x - card_width // 2
        card_x = max(EDGE_MARGIN, min(card_x, geometry.width - card_width - EDGE_MARGIN))
        card_origin_x = max(16, min(local_pointer_x - card_x, card_width - 16))
        card_y = waybar_bottom(waybar_output(), geometry.y) + 8
        max_height = max(240, geometry.height - card_y - EDGE_MARGIN)

        self.window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        self.window.set_name("waybar-control-overlay")
        self.window.set_app_paintable(True)
        visual = self.window.get_screen().get_rgba_visual()
        if visual is not None:
            self.window.set_visual(visual)

        GtkLayerShell.init_for_window(self.window)
        GtkLayerShell.set_namespace(self.window, "waybar-control")
        GtkLayerShell.set_layer(self.window, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_monitor(self.window, monitor)
        GtkLayerShell.set_exclusive_zone(self.window, -1)
        GtkLayerShell.set_keyboard_mode(self.window, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.RIGHT, GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT):
            GtkLayerShell.set_anchor(self.window, edge, True)

        overlay = Gtk.Overlay()
        overlay.set_name("control-root")
        self.window.add(overlay)

        click_catcher = Gtk.EventBox()
        click_catcher.set_visible_window(False)
        click_catcher.set_hexpand(True)
        click_catcher.set_vexpand(True)
        click_catcher.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        click_catcher.connect("button-press-event", lambda *_args: self.close() or True)
        overlay.add(click_catcher)

        self.morph = IconMorph(card_origin_x)
        self.morph.set_size_request(card_width, -1)
        self.morph.set_halign(Gtk.Align.START)
        self.morph.set_valign(Gtk.Align.START)
        self.morph.set_margin_start(card_x)
        self.morph.set_margin_top(card_y)
        overlay.add_overlay(self.morph)

        surface = Gtk.EventBox()
        surface.set_visible_window(True)
        surface.set_name("control-card")
        surface.set_size_request(card_width, -1)
        self.morph.add(surface)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        surface.add(card)
        card.pack_start(self._header(), False, False, 0)
        if password:
            card.pack_start(self._password_content(), False, False, 0)
        else:
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.set_propagate_natural_height(True)
            scroller.set_max_content_height(max_height - 74)
            scroller.get_style_context().add_class("control-scroller")
            scroller.add(self._menu_content())
            card.pack_start(scroller, True, True, 0)

        self.window.connect("key-press-event", self._key_pressed)
        self.window.connect("destroy", Gtk.main_quit)
        self._load_css()
        self.window.show_all()
        GLib.idle_add(self._reveal)

    def _load_css(self) -> None:
        theme_path = Path(os.path.expanduser("~/.config/waybar/colors.css"))
        component_path = Path(os.path.expanduser("~/.config/waybar/control-menu.css"))
        provider = Gtk.CssProvider()
        provider.load_from_data(theme_path.read_bytes() + b"\n" + component_path.read_bytes())
        Gtk.StyleContext.add_provider_for_screen(
            self.window.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _header(self) -> Gtk.Widget:
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.get_style_context().add_class("control-header")
        if self.model.get("icon"):
            header.pack_start(make_label(self.model["icon"], "control-header-icon", 0.5), False, False, 0)
        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        text_box.pack_start(make_label(self.model.get("title", "Controls"), "control-title"), False, False, 0)
        if self.model.get("subtitle"):
            text_box.pack_start(make_label(self.model["subtitle"], "control-subtitle"), False, False, 0)
        header.pack_start(text_box, True, True, 0)
        close = Gtk.Button(label="󰅖")
        close.set_tooltip_text("Close")
        close.get_accessible().set_name("Close")
        close.get_style_context().add_class("control-icon-button")
        close.connect("clicked", lambda _button: self.close())
        header.pack_end(close, False, False, 0)
        return header

    def _menu_content(self) -> Gtk.Widget:
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        content.get_style_context().add_class("control-content")
        banner = self.model.get("banner")
        if banner:
            banner_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            banner_box.get_style_context().add_class("control-banner")
            if banner.get("tone") == "error":
                banner_box.get_style_context().add_class("error")
            banner_box.pack_start(make_label(banner.get("icon", "󰅚"), "row-icon", 0.5), False, False, 0)
            banner_box.pack_start(make_label(banner.get("text", ""), "row-supporting"), True, True, 0)
            content.pack_start(banner_box, False, False, 0)

        if self.model.get("toggle"):
            content.pack_start(self._toggle_row(self.model["toggle"]), False, False, 0)

        for section in self.model.get("sections", []):
            rows = section.get("rows", [])
            if not rows:
                continue
            section_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            section_box.get_style_context().add_class("control-section")
            if section.get("title"):
                section_box.pack_start(make_label(section["title"], "section-title"), False, False, 0)
            for row in rows:
                section_box.pack_start(self._action_row(row), False, False, 0)
            content.pack_start(section_box, False, False, 0)

        footer = self.model.get("footer", [])
        if footer:
            footer_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            footer_box.get_style_context().add_class("control-footer")
            for action in footer:
                button = Gtk.Button(label=action.get("title", "Action"))
                button.get_style_context().add_class("control-footer-button")
                if action.get("filled"):
                    button.get_style_context().add_class("filled")
                button.get_accessible().set_name(action.get("title", "Action"))
                button.connect("clicked", lambda _button, value=action.get("action", ""): self._choose(value))
                footer_box.pack_start(button, True, True, 0)
                self.controls.append(button)
            content.pack_start(footer_box, False, False, 0)
        return content

    def _toggle_row(self, toggle: dict) -> Gtk.Widget:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.get_style_context().add_class("control-toggle-row")
        if toggle.get("icon"):
            row.pack_start(make_label(toggle["icon"], "row-icon", 0.5), False, False, 0)
        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        text_box.pack_start(make_label(toggle.get("title", ""), "row-title"), False, False, 0)
        if toggle.get("subtitle"):
            text_box.pack_start(make_label(toggle["subtitle"], "row-supporting"), False, False, 0)
        row.pack_start(text_box, True, True, 0)
        switch = Gtk.Switch()
        switch.set_active(bool(toggle.get("active")))
        switch.set_valign(Gtk.Align.CENTER)
        switch.get_accessible().set_name(toggle.get("title", "Toggle"))
        switch.connect("state-set", lambda _switch, _state: self._toggle(toggle.get("action", "")))
        row.pack_end(switch, False, False, 0)
        self.controls.append(switch)
        return row

    def _toggle(self, action: str) -> bool:
        if not self.ready:
            return False
        self._choose(action)
        return True

    def _action_row(self, row: dict) -> Gtk.Widget:
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.get_style_context().add_class("control-row")
        if row.get("selected"):
            button.get_style_context().add_class("selected")
        if row.get("danger"):
            button.get_style_context().add_class("danger")
        button.set_sensitive(not row.get("disabled", False))
        button.get_accessible().set_name(row.get("title", "Action"))
        button.connect("clicked", lambda _button, value=row.get("action", ""): self._choose(value))
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        if row.get("icon"):
            box.pack_start(make_label(row["icon"], "row-icon", 0.5), False, False, 0)
        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        text_box.pack_start(make_label(row.get("title", ""), "row-title"), False, False, 0)
        if row.get("subtitle"):
            text_box.pack_start(make_label(row["subtitle"], "row-supporting"), False, False, 0)
        box.pack_start(text_box, True, True, 0)
        if row.get("trailing"):
            box.pack_end(make_label(row["trailing"], "row-trailing", 1), False, False, 0)
        button.add(box)
        self.controls.append(button)
        return button

    def _password_content(self) -> Gtk.Widget:
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        content.get_style_context().add_class("password-content")
        content.pack_start(make_label(self.model.get("message", "Enter the network password"), "row-supporting"), False, False, 0)
        self.entry = Gtk.Entry()
        self.entry.set_visibility(False)
        self.entry.set_invisible_char("●")
        self.entry.set_placeholder_text("Password")
        self.entry.get_accessible().set_name("Wi-Fi password")
        self.entry.connect("activate", lambda _entry: self._choose(self.entry.get_text()))
        content.pack_start(self.entry, False, False, 0)
        connect = Gtk.Button(label="Connect")
        connect.get_style_context().add_class("control-filled-button")
        connect.connect("clicked", lambda _button: self._choose(self.entry.get_text()))
        content.pack_start(connect, False, False, 0)
        self.controls.extend([self.entry, connect])
        return content

    def _reveal(self) -> bool:
        self.ready = True
        self.morph.animate(True, self._focus_first_control)
        return GLib.SOURCE_REMOVE

    def _focus_first_control(self) -> None:
        if self.controls:
            self.controls[0].grab_focus()

    def _key_pressed(self, _window: Gtk.Window, event: Gdk.EventKey) -> bool:
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if event.keyval not in (Gdk.KEY_Up, Gdk.KEY_Down) or not self.controls:
            return False
        focused = self.window.get_focus()
        try:
            index = self.controls.index(focused)
        except ValueError:
            index = -1
        step = 1 if event.keyval == Gdk.KEY_Down else -1
        for offset in range(1, len(self.controls) + 1):
            candidate = self.controls[(index + step * offset) % len(self.controls)]
            if candidate.get_sensitive() and candidate.get_visible():
                candidate.grab_focus()
                break
        return True

    def _choose(self, value: str) -> None:
        if value and not self.result_written:
            print(value, flush=True)
            self.result_written = True
        self.close()

    def close(self) -> None:
        if self.closing:
            return
        self.closing = True
        self.morph.animate(False, self._finish_close)

    @staticmethod
    def _finish_close() -> None:
        Gtk.main_quit()


def read_model(title: str, password: bool) -> dict:
    if password:
        return {"title": title, "icon": "󰌾", "message": "Enter the network password"}
    raw = sys.stdin.read()
    try:
        model = json.loads(raw)
        if not isinstance(model, dict):
            raise ValueError("popup model must be an object")
        return model
    except (json.JSONDecodeError, ValueError):
        rows = [line for line in raw.splitlines() if line]
        return {"title": title, "sections": [{"rows": [{"title": text, "action": str(index)} for index, text in enumerate(rows)]}]}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--title", default="Controls")
    parser.add_argument("--password", action="store_true")
    parser.add_argument("--pointer-x", type=int, required=True)
    parser.add_argument("--pointer-y", type=int, required=True)
    args = parser.parse_args()
    model = read_model(args.title, args.password)
    if not args.password and not model.get("toggle") and not model.get("sections"):
        return 0
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    popup = Popup(model, args.password, args.pointer_x, args.pointer_y)
    Gtk.main()
    _ = popup
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
