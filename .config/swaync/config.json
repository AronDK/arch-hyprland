{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 49,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 24,
  "notification-body-image-height": 100,
  "notification-body-image-width": 100,
  "notification-window-width": 408,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 408,
  "control-center-height": 820,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
      "title",
      "dnd",
      "buttons-grid",
      "mpris",
      "notifications"
  ],
  "widget-config": {
      "title": {
          "text": "Notifications",
          "clear-all-button": true,
          "button-text": "Clear all"
      },
      "backlight": {
          "label": "󰃟"
      },
      "dnd": {
          "text": "Do Not Disturb"
      },
      "label": {
          "max-lines": 1,
          "text": "Notification"
      },
      "mpris": {
          "show-album-art": "when-available",
          "autohide": true
      },
      "buttons-grid": {
          "buttons-per-row": 2,
          "actions": [
              {
                  "label": "󰐥  Power",
                  "command": "bash -c $HOME/.config/hypr/scripts/Wlogout.sh"
              },
              {
                  "label": "󰌾  Lock",
                  "command": "bash -c $HOME/.config/hypr/scripts/hyprlock.sh"
              },
              {
                  "label": "󰍃  Log out",
                  "command": "hyprctl dispatch exit"
              },
              {
                  "label": "󰀝  Airplane",
                  "command": "bash -c $HOME/.config/hypr/scripts/AirplaneMode.sh"
              },
              {
                  "label": "󰝟  Mute",
                  "type": "toggle",
                  "active": false,
                  "command": "sh -c 'if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then pactl set-sink-mute @DEFAULT_SINK@ 1; else pactl set-sink-mute @DEFAULT_SINK@ 0; fi'",
                  "update-command": "sh -c 'pactl get-sink-mute @DEFAULT_SINK@ | grep -q yes && echo true || echo false'"
              }
          ]
      }
  }
}
